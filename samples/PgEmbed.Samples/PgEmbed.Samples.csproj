<Project Sdk="Microsoft.NET.Sdk">

  <!-- The C# code the docs show, as region snippets (#region sample_*). It is an xUnit test project, so CI
       runs the samples against real Postgres instead of only compiling them. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>PgEmbed.Samples</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MysticMind.PostgresEmbed" Version="[5.2.1, 6.0.0)" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
