<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- .NET 10 and later (RollForward). .NET 8 and 9 reach end of support on 2026-11-10, and
         platform-specific tool packages need the .NET 10 SDK to install anyway. -->
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>Major</RollForward>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>pgembed</ToolCommandName>
    <PackageId>pgembed</PackageId>
    <!-- One package per platform, precompiled (ReadyToRun) for a faster start, plus a portable "any"
         package for other platforms; a top-level package points at them, and dotnet tool install and
         dnx pick the right one. Push the platform packages before the top-level one. -->
    <RuntimeIdentifiers>win-x64;linux-x64;linux-arm64;linux-musl-x64;linux-musl-arm64;osx-x64;osx-arm64;any</RuntimeIdentifiers>
    <ToolPackageRuntimeIdentifiers>$(RuntimeIdentifiers)</ToolPackageRuntimeIdentifiers>
    <PublishReadyToRun>true</PublishReadyToRun>
    <SelfContained>false</SelfContained>
    <!-- also an MCP server: nuget.org shows its configuration, and dnx pgembed mcp runs it -->
    <PackageType>McpServer</PackageType>
    <VersionPrefix>0.2.0</VersionPrefix>
    <Description>Run PostgreSQL locally without installing it: named instances of any version in the background, SQL with readable results and errors, schema inspection, SQL formatting, and an MCP server for AI assistants. Built on MysticMind.PostgresEmbed.</Description>
    <Authors>Babu Annamalai</Authors>
    <Copyright>Copyright (C) Babu Annamalai</Copyright>
    <PackageTags>postgres;postgresql;pg;embedded;cli;dotnet-tool;testing;mcp;mcp-server</PackageTags>
    <PackageProjectUrl>https://github.com/mysticmind/pgembed-cli</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mysticmind/pgembed-cli</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" />
    <None Include=".mcp\server.json" Pack="true" PackagePath="\.mcp\" />
    <InternalsVisibleTo Include="pgembed.Tests" />
    <InternalsVisibleTo Include="pgembed.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.Core" Version="1.4.1" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="pgsqlparser" Version="2.1.0" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <PackageReference Include="System.CommandLine" Version="2.0.14" />
  </ItemGroup>

  <!-- the interactive prompt's line editor -->
  <ItemGroup>
    <PackageReference Include="PrettyPrompt" Version="6.0.5" />
  </ItemGroup>

  <!-- The published library by default. To build against a local checkout before a library
       release, pass -p:PgEmbedLibraryProject=<path to MysticMind.PostgresEmbed.csproj>. -->
  <ItemGroup Condition="'$(PgEmbedLibraryProject)' == ''">
    <PackageReference Include="MysticMind.PostgresEmbed" Version="[5.2.1, 6.0.0)" />
  </ItemGroup>
  <ItemGroup Condition="'$(PgEmbedLibraryProject)' != ''">
    <ProjectReference Include="$(PgEmbedLibraryProject)" />
  </ItemGroup>
</Project>
