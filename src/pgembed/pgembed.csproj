<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net8.0 runs on .NET 8 and 9; net10.0 on .NET 10 and later. dotnet tool install picks the
         newest one the machine's runtime supports. They differ only in the line editor's version. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RollForward>Major</RollForward>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>pgembed</ToolCommandName>
    <PackageId>pgembed</PackageId>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Description>Run PostgreSQL locally without installing it: named instances of any version in the background, SQL with readable results and errors, version and extension discovery, and a shared download cache. Built on MysticMind.PostgresEmbed.</Description>
    <Authors>Babu Annamalai</Authors>
    <Copyright>Copyright (C) Babu Annamalai</Copyright>
    <PackageTags>postgres;postgresql;pg;embedded;cli;dotnet-tool;testing</PackageTags>
    <PackageProjectUrl>https://github.com/mysticmind/pgembed-cli</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mysticmind/pgembed-cli</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="pgembed.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="pgsqlparser" Version="2.1.0" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.57.2" />
  </ItemGroup>

  <!-- The interactive prompt's line editor. Its maintained releases (5.x and later) need .NET 10;
       4.1 has the same API and serves .NET 8 and 9. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="PrettyPrompt" Version="4.1.1" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net8.0'">
    <PackageReference Include="PrettyPrompt" Version="6.0.5" />
  </ItemGroup>

  <!-- The published library by default. To build against a local checkout before a library
       release, pass -p:PgEmbedLibraryProject=<path to MysticMind.PostgresEmbed.csproj>. -->
  <ItemGroup Condition="'$(PgEmbedLibraryProject)' == ''">
    <PackageReference Include="MysticMind.PostgresEmbed" Version="[5.2.1, 6.0.0)" />
  </ItemGroup>
  <ItemGroup Condition="'$(PgEmbedLibraryProject)' != ''">
    <ProjectReference Include="$(PgEmbedLibraryProject)" />
  </ItemGroup>
</Project>
