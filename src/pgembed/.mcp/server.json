{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.mysticmind/pgembed",
  "title": "pgembed",
  "description": "Real PostgreSQL of any version, locally, without Docker: run instances and SQL, inspect schemas.",
  "version": "0.2.2",
  "repository": {
    "url": "https://github.com/mysticmind/pgembed-cli",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "nuget",
      "registryBaseUrl": "https://api.nuget.org",
      "identifier": "pgembed",
      "version": "0.2.2",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    },
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "pgembed",
      "version": "0.2.2",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
